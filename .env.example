# --- Application ---
APP_ENV=development
SECRET_KEY=replace-with-64-char-random-hex
JWT_SECRET_KEY=replace-with-different-64-char-random-hex
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# --- Public Origin (Cloudflare Tunnel URL) ---
PUBLIC_BASE_URL=https://callsphere-dev.yourdomain.me
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://callsphere-dev.yourdomain.me

# --- Local MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=callsphere_v2
DB_USER=callsphere_app
DB_PASSWORD=replace-with-local-db-password
DB_POOL_SIZE=10

# --- Local Redis (Presence, Call State, Rate Limits, OTP TTL) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Local Media Storage (Encrypted Attachments & Voicemails) ---
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=10

# --- Email OTP / 2FA (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-email@example.com
SMTP_PASS=replace-with-app-password

# --- WebRTC STUN / TURN (Metered Open Relay or Coturn) ---
STUN_URL=stun:stun.relay.metered.ca:80
TURN_URL=turns:global.relay.metered.ca:443?transport=tcp
TURN_USERNAME=replace-with-turn-username
TURN_CREDENTIAL=replace-with-turn-credential

# --- Push Notifications (Web Push VAPID + Mobile FCM) ---
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:admin@callsphere.local
FCM_CREDENTIALS_PATH=./secrets/firebase-adminsdk.json